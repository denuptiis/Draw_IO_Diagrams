        <mxCell id="cp-19" value="" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F2A541;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;dashed=1;dashPattern=8 8;" parent="1" source="cp-12" target="cp-16" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-20" value='&lt;font style="font-size: 15px;" color="#FFFFFF"&gt;&lt;b&gt;Captive portal rules on GUEST interface&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 13px;" color="#E4FDE1"&gt;- Zone bound to GUEST interface&lt;br&gt;- Unauthenticated: only DNS + DHCP + portal (TCP 8000/8001)&lt;br&gt;- Authenticated: pass to WAN only&lt;br&gt;- Block RFC1918 -&gt; LAN (client isolation)&lt;br&gt;- Idle timeout 30 min / hard timeout 8 h&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E3A4A;strokeColor=#F2A541;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="430" y="800" width="230" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cp-21" value='&lt;font style="font-size: 14px;" color="#F2A541"&gt;Guest traffic is allowed to the Internet only.&lt;br&gt;No route to the trusted LAN.&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="430" y="1020" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cp-22" value="LAN VLAN 1 - Trusted  (192.168.1.0/24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#05F034;strokeWidth=3;dashed=1;dashPattern=12 8;fontColor=#05F034;fontSize=20;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="720" y="760" width="540" height="400" as="geometry" />
        </mxCell>
        <mxCell id="cp-23" value='&lt;font style="font-size: 16px;" color="#FFFFFF"&gt;&lt;b&gt;Auth Server (optional)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 13px;" color="#E4FDE1"&gt;FreeRADIUS / LDAP / AD&lt;br&gt;192.168.1.10&lt;/font&gt;' style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#028090;strokeColor=#FFFFFF;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.server;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="800" y="820" width="90" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cp-24" value="VLAN 1" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#05F034;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="cp-9" target="cp-23" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-25" value="RADIUS 1812/1813 (auth + accounting)" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B388FF;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=block;endFill=1;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;dashed=1;dashPattern=8 8;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" source="cp-5" target="cp-23" edge="1">
          <mxGeometry relative="1" as="geometry">
