          </mxGeometry>
        </mxCell>
        <mxCell id="cp-26" value='&lt;font style="font-size: 15px;" color="#FFFFFF"&gt;Admin PC&lt;/font&gt;' style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.pc;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="1000" y="830" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cp-27" value='&lt;font style="font-size: 15px;" color="#FFFFFF"&gt;NAS / Internal Services&lt;/font&gt;' style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.storage;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="1130" y="830" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cp-28" value="" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#05F034;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;dashed=1;dashPattern=8 8;" parent="1" source="cp-23" target="cp-26" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-29" value="" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#05F034;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;dashed=1;dashPattern=8 8;" parent="1" source="cp-23" target="cp-27" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-30" value='&lt;font style="font-size: 15px;" color="#FFFFFF"&gt;&lt;b&gt;Trusted LAN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 13px;" color="#E4FDE1"&gt;- Full access to Internet and internal services&lt;br&gt;- Captive portal NOT enabled on this interface&lt;br&gt;- Reaches OPNsense GUI on 443 for administration&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E3A4A;strokeColor=#05F034;strokeWidth=2;fontColor=#FFFFFF;fontSize=16;arcSize=12;" parent="1" vertex="1">
          <mxGeometry x="800" y="1000" width="430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cp-31" value='&lt;font style="font-size: 16px;" color="#FFFFFF"&gt;&lt;b&gt;Legend&lt;/b&gt;&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="40" y="1200" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cp-32" value='&lt;font style="font-size: 13px;" color="#E4FDE1"&gt;Red = WAN   Green = trusted LAN   Orange = guest/captive portal   Purple dashed = RADIUS backchannel&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#FFFFFF;" parent="1" vertex="1">
