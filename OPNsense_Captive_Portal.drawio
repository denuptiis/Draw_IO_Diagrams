        <mxCell id="cp-17" value="" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F2A541;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;dashed=1;dashPattern=8 8;" parent="1" source="cp-12" target="cp-14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-18" value="" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F2A541;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;dashed=1;dashPattern=8 8;" parent="1" source="cp-12" target="cp-15" edge="1">
          <mxGeometry relative="1" as="geometry" />
