        <mxCell id="cp-12" value='&lt;font style="font-size: 18px;" color="#FFFFFF"&gt;&lt;b&gt;Wi-Fi AP&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 13px;" color="#E4FDE1"&gt;SSID "Guest" tagged VLAN 50&lt;/font&gt;' style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#F2A541;strokeColor=#FFFFFF;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.wireless_hub;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="120" y="820" width="110" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cp-13" value="VLAN 50" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F2A541;strokeWidth=3;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="cp-9" target="cp-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-14" value='&lt;font style="font-size: 15px;" color="#FFFFFF"&gt;Guest Laptop&lt;/font&gt;' style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.laptop;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="90" y="1010" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cp-15" value='&lt;font style="font-size: 15px;" color="#FFFFFF"&gt;Guest Phone&lt;/font&gt;' style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.mobile;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
