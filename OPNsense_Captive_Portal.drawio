        <mxCell id="cp-11" value="GUEST VLAN 50 - Captive Portal Zone  (192.168.50.0/24)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#F2A541;strokeWidth=3;dashed=1;dashPattern=12 8;fontColor=#F2A541;fontSize=20;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="40" y="760" width="640" height="400" as="geometry" />
