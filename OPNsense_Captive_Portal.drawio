<mxfile host="Electron" modified="2026-10-04T07:00:00.000Z" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/22.0.3 Chrome/114.0.5735.289 Electron/25.8.4 Safari/537.36" etag="OPNsenseCaptivePortal1" version="22.0.3" type="device" pages="2">
  <diagram name="Topology" id="cp-59">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" background="#114B5F" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cp-1" value='&lt;font style="font-size: 30px;" color="#FFFFFF"&gt;&lt;b&gt;OPNsense Captive Portal - Guest Network Topology&lt;/b&gt;&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="40" y="10" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cp-2" value='&lt;font style="font-size: 15px;" color="#E4FDE1"&gt;Guest clients land in an isolated VLAN. OPNsense intercepts their web traffic and holds it at the portal login page until they authenticate. Trusted LAN is never reachable from the guest zone.&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="40" y="60" width="1100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cp-3" value='&lt;font style="font-size: 24px;" color="#FFFFFF"&gt;&lt;b&gt;Internet&lt;/b&gt;&lt;/font&gt;' style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#FFFFFF;strokeColor=#006EAF;fontSize=22;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="420" y="130" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cp-4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#E4FDE1;strokeWidth=3;dashed=1;dashPattern=12 8;fontColor=#E4FDE1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" parent="1" vertex="1">
          <mxGeometry x="330" y="350" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cp-5" value="" style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#F45B69;strokeColor=#FFFFFF;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.firewall;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="380" y="390" width="130" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cp-6" value='&lt;font style="font-size: 26px;" color="#FFFFFF"&gt;&lt;b&gt;OPNsense&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 14px;" color="#E4FDE1"&gt;Firewall / Router / Captive Portal&lt;/font&gt;' style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="520" y="380" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cp-7" value='&lt;font style="font-size: 16px;" color="#FF0000"&gt;&lt;b&gt;WAN&lt;/b&gt;&lt;/font&gt; - DHCP / PPPoE from ISP&lt;br&gt;&lt;font style="font-size: 16px;" color="#05F034"&gt;&lt;b&gt;LAN&lt;/b&gt;&lt;/font&gt; - 192.168.1.1/24 (trusted)&lt;br&gt;&lt;font style="font-size: 16px;" color="#F2A541"&gt;&lt;b&gt;GUEST (VLAN 50)&lt;/b&gt;&lt;/font&gt; - 192.168.50.1/24' style="text;strokeColor=none;fillColor=none;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#FFFFFF;" parent="1" vertex="1">
          <mxGeometry x="520" y="450" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cp-8" value="WAN" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF0000;strokeWidth=4;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="cp-3" target="cp-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cp-9" value='&lt;font style="font-size: 18px;" color="#FFFFFF"&gt;&lt;b&gt;Managed Switch&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style="font-size: 13px;" color="#E4FDE1"&gt;Trunk: VLAN 1 (LAN) + VLAN 50 (GUEST)&lt;/font&gt;' style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#028090;strokeColor=#FFFFFF;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.switch;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
          <mxGeometry x="500" y="620" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cp-10" value="802.1Q trunk" style="edgeStyle=none;shape=connector;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#05F034;strokeWidth=4;fontFamily=Helvetica;fontSize=14;fontColor=#FFFFFF;labelBackgroundColor=#114B5F;endArrow=none;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=8;targetPerimeterSpacing=8;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="cp-5" target="cp-9" edge="1">
          <mxGeometry relative="1" as="geometry" />
