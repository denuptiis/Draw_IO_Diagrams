        <mxCell id="cp-16" value='&lt;font style="font-size: 15px;" color="#FFFFFF"&gt;Guest Tablet&lt;/font&gt;' style="fontColor=#FFFFFF;verticalAlign=top;verticalLabelPosition=bottom;labelPosition=center;align=center;html=1;outlineConnect=0;fillColor=#CCCCCC;strokeColor=#6881B3;gradientColor=none;strokeWidth=2;shape=mxgraph.networks.tablet;fontFamily=Helvetica;fontSize=16;" parent="1" vertex="1">
